{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngl-v1",
  "main": "worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "STYLIST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SUPPORT_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  // Non-secret config (the Supabase URL is already public in the client bundle).
  // The service-role key and the LLM key (GROQ_API_KEY, else GEMINI_API_KEY)
  // are SECRETS — set them on the Worker:
  // dashboard → Workers & Pages → ngl-v1 → Settings → Variables and Secrets.
  "vars": {
    "STYLIST_AI_ENABLED": "true",
    "SUPABASE_URL": "https://vevzlrnwhckuekkvujhq.supabase.co",
    // gemini-2.0-flash has 0 free-tier quota on this Google account (→ 429);
    // 2.5-flash works. Pinned here so a stray dashboard var can't break it.
    "GEMINI_MODEL": "gemini-2.5-flash",
    // Used only when GROQ_API_KEY is set (Groq then replaces Gemini entirely).
    // llama-3.3-70b is NOT on this Groq account (404 model_not_found);
    // gpt-oss-120b / -20b are. Verified 2026-09-20 via /openai/v1/models.
    "GROQ_MODEL": "openai/gpt-oss-120b"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      // /img/* is the Supabase Storage caching proxy in worker.js. Without it
      // here the asset router answers first and not_found_handling returns
      // index.html for every image (200 text/html), so the proxy never runs.
      "/img/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
