# Local dev secrets for the AI support chatbot.
# Copy this file to ".env.local" (already gitignored) and fill in real values.
# NEVER commit real keys.

# Google Gemini (free) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Supabase service role key — Supabase dashboard → Settings → API → service_role.
# Server-side only. NEVER expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_URL is reused from VITE_SUPABASE_URL in .env; override only if needed.
# SUPABASE_URL=https://yourproject.supabase.co

# Optional: admin escalation emails (reuse your existing Resend setup)
# RESEND_API_KEY=
# ADMIN_EMAIL=you@example.com
# FROM_EMAIL=NGL Accessories <noreply@yourdomain.com>
